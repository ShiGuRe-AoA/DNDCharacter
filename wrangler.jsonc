{
  "name": "dndcharacter",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"]
  },
  "d1_databases": [
    { "binding": "DB" },
    { "binding": "RULES_DB", "migrations_dir": "rules-migrations" }
  ]
}
